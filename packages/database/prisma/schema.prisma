generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  // "native" keeps local dev working; "rhel-openssl-3.0.x" is the engine the
  // Vercel Function runtime (Amazon Linux 2023) needs at runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Ingredient {
  id        String             @id @default(uuid())
  name      String             @unique
  namePt    String? // Portuguese translation of the generic name (brands/proper nouns stay null)
  category  IngredientCategory
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  userIngredients   UserIngredient[]
  recipeIngredients RecipeIngredient[]

  @@map("ingredients")
}

model UserIngredient {
  id           String   @id @default(uuid())
  userId       String
  ingredientId String
  createdAt    DateTime @default(now())

  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([userId, ingredientId])
  @@map("user_ingredients")
}

model Recipe {
  id     String  @id @default(uuid())
  name   String  @unique
  namePt String? // Portuguese drink name; null keeps the original (filled in manually)

  instructions   String
  instructionsPt String? // Portuguese translation of the instructions
  imageUrl       String? // source thumbnail URL from the cocktail dataset
  glassType      String? // e.g. "Cocktail glass", "Highball glass"
  alcoholic      String? // "Alcoholic" | "Non alcoholic" | "Optional alcohol"
  flavorTags     FlavorTag[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  ingredients          RecipeIngredient[]
  ratings              Rating[]
  favorites            Favorite[]
  recommendationEvents RecommendationEvent[]

  @@map("recipes")
}

model RecipeIngredient {
  id           String  @id @default(uuid())
  recipeId     String
  ingredientId String
  amount       String // original free-text source value (fallback / audit)
  // Canonical volume in millilitres, parsed from `amount`. Null when the
  // amount isn't a convertible liquid volume (dashes, parts, "to taste", …).
  quantityMl   Float?
  // The non-volumetric remainder shown verbatim when quantityMl is null
  // (e.g. "2 dashes", "1/2 shot", "to taste").
  note         String?

  recipe     Recipe     @relation(fields: [recipeId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

model Rating {
  id        String   @id @default(uuid())
  userId    String
  recipeId  String
  score     Int // 1-5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipe Recipe @relation(fields: [recipeId], references: [id])

  @@unique([userId, recipeId])
  @@map("ratings")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  recipeId  String
  createdAt DateTime @default(now())

  recipe Recipe @relation(fields: [recipeId], references: [id])

  @@unique([userId, recipeId])
  @@map("favorites")
}

model UserSettings {
  id              String          @id @default(uuid())
  userId          String          @unique
  age             Int?
  sex             Sex?
  measurementUnit MeasurementUnit @default(ML)
  scoreType       ScoreType       @default(FIVE_STARS)
  language        Language        @default(EN)
  theme           String          @default("midnight")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("user_settings")
}

// A trained snapshot of the neural recommender (TensorFlow.js). The Vercel
// Function filesystem is ephemeral, so the whole model lives here: topology +
// weight specs as JSON, the weight values as raw bytes (a few KB).
model ModelVersion {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Only one row is active at a time — the one /recommendations serves from.
  active    Boolean @default(false)
  // True when trained on generated users (pipeline smoke tests), never real data.
  synthetic Boolean @default(false)

  ratingsCount Int
  usersCount   Int
  // Training/validation numbers: loss, valMae, meanBaselineMae, epochs, …
  metrics      Json

  // Feature vocabulary the weights were trained against (ingredient ids,
  // glass types, …). Inference must encode inputs with this exact ordering.
  vocab       Json
  topology    Json
  weightSpecs Json
  weights     Bytes

  events RecommendationEvent[]

  @@index([active])
  @@map("model_versions")
}

// One row per recipe shown by /recommendations — which engine produced it and
// at what rank. Joined against ratings/favorites created afterwards, this is
// what lets the neural model be compared with the baseline on real behaviour.
model RecommendationEvent {
  id             String               @id @default(uuid())
  userId         String
  recipeId       String
  engine         RecommendationEngine
  modelVersionId String?
  score          Float
  position       Int
  createdAt      DateTime             @default(now())

  recipe       Recipe        @relation(fields: [recipeId], references: [id])
  modelVersion ModelVersion? @relation(fields: [modelVersionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([recipeId])
  @@map("recommendation_events")
}

enum RecommendationEngine {
  BASELINE
  NEURAL
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum MeasurementUnit {
  OZ
  ML
}

enum ScoreType {
  FIVE_STARS
  ONE_TO_TEN
}

enum Language {
  EN
  PT
}

enum IngredientCategory {
  SPIRIT
  LIQUEUR
  FERMENTED // wine, beer, cider, port, sherry, champagne
  MIXER
  BITTER
  GARNISH
  SYRUP
  OTHER
}

enum FlavorTag {
  SOUR
  SWEET
  BITTER
  BOOZY
  REFRESHING
  CREAMY
  SPICY
  FRUITY
  HERBAL
}
