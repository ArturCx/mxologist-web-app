# Copy to packages/database/.env (read by the Prisma CLI: db:generate / db:migrate).
# Same values as apps/api/.env.

# Neon → Connect → pooled connection (host has -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Neon → Connect → direct connection (pooling OFF). Used for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"
