# Copy to apps/api/.env (loaded by `dotenv/config` in src/main.ts).

# Neon dashboard → project → Connect → "Pooled connection" (host has -pooler).
# Used by the Prisma client at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Neon dashboard → Connect → same string with "Connection pooling" OFF.
# Used by Prisma for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Clerk dashboard → Configure → API keys → Secret keys (sk_test_...).
# Must be the same Clerk instance as the web app's publishable key.
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated CORS allowlist. Defaults to http://localhost:3000 if unset.
WEB_APP_URL=http://localhost:3000

# Protects GET /api/ml/train (the neural recommender's retraining endpoint).
# Vercel Cron sends it automatically as `Authorization: Bearer <value>` once
# the variable exists on the project. Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional. Minimum number of ratings before a real training run happens
# (defaults to 50); below it the cron call is a no-op.
# ML_MIN_RATINGS=50

# Optional, defaults to 4000. Do NOT set on Vercel.
# PORT=4000
